   "filterBodyDictionary": {
    "type": "object",
    "description": "\"Keys are same as dimensions. Values are an array of values to match for the dimension. An object defining filters to match or disallow certain values. Example: [\"install_activity_touch_data_tilde_campaign\": [\"A4G\"]]\"\n",
    "additionalProperties": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "example": {
     "install_activity_touch_data_tilde_campaign": [
      "A4G"
     ]
    },
    "properties": {
     "app_id": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "install_activity_attributed": {
      "type": "array",
      "items": {
       "type": "string",
       "example": "true",
       "enum": [
        "true",
        "false"
       ]
      }
     },
     "install_activity_event_name": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "install_activity_touch_type": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "CLICK",
        "IMPRESSION",
        "WEB_TO_APP_AUTO_REDIRECT"
