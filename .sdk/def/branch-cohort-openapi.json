      "default": "install_cohort",
      "example": "install_cohort",
      "description": "A string value representing the cohort type"
     },
     "measures": {
      "maxItems": "3",
      "minItems": "1",
      "type": "array",
      "description": "The cohort measures to return. Limit is 3. See [Measure](https://help.branch.io/developers-hub/docs/cohort-exports#section-measures) for complete list.\n",
      "default": [
       "OPEN"
      ],
      "example": [
       "OPEN"
      ],
      "items": {
       "type": "string",
       "enum": [
        "OPEN",
        "users",
        "Retention",
        "ARPPU",
        "LTV",
        "ARPU",
        "revenue",
