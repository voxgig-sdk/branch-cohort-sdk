    "type": "object",
    "properties": {
     "job_id": {
      "type": "string",
      "example": "0000-XXxx",
      "description": "Unique identifier used to retrieve job status and data."
     },
     "code": {
      "type": "string",
      "description": "HTTP code representing the outcome of the export request.\n",
      "example": "200"
     },
     "status_url": {
      "type": "string",
      "example": "https://api2.branch.io/v2/analytics/{UNIQUE_ALPHANUMERICAL_STATUS_PATH_HERE}",
