# Entity: analytics

main: kit: entity: analytics: {

  alias: field: {}

  fields: [
    {
      name: "code"
      req: false
      short: "HTTP code representing the outcome of the status request."
      type: "`$STRING`"
    }
    {
      name: "cumulative"
      req: false
      short: "If true, sum across bands so that a given band value is the sum of all preceding values plus the band value."
      type: "`$BOOLEAN`"
    }
    {
      name: "data_source"
      req: true
      short: "A string value representing the cohort type"
      type: "`$STRING`"
    }
    {
      name: "dimensions"
      req: false
      short: "An array representing dimension(s) to group by."
      type: "`$ARRAY`"
    }
    {
      name: "enable_install_recalculation"
      req: false
      short: "If true, then Branch will de-dupe unattributed installs caused by duplicate events from non-opt-in users coming from paid ads."
      type: "`$BOOLEAN`"
    }
    {
      format: "date"
      name: "end_date"
      req: true
      short: "The end of the interval time range represented as an ISO-8601 complete date."
      type: "`$STRING`"
    }
    {
      name: "error_message"
      req: false
      short: "Error message if the query failed"
      type: "`$STRING`"
    }
    {
      name: "filter"
      req: false
      short: "\"Keys are same as dimensions."
      type: "`$OBJECT`"
    }
    {
      name: "granularity"
      req: false
      short: "The time granularity that each band value will represent."
      type: "`$STRING`"
    }
    {
      name: "granularity_band_count"
      req: true
      short: "Number of time units since the cohort event to return to the user."
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "job_id"
      req: false
      short: "Unique identifier used to retrieve job status and data."
      type: "`$STRING`"
    }
    {
      name: "measures"
      req: true
      short: "The cohort measures to return."
      type: "`$ARRAY`"
    }
    {
      name: "ordered"
      req: false
      short: "Order of response based on ordered_by value."
      type: "`$STRING`"
    }
    {
      name: "ordered_by"
      req: false
      short: "The dimension used for sorting"
      type: "`$STRING`"
    }
    {
      name: "per_user"
      req: false
      short: "If true, divide each band value by the user count."
      type: "`$BOOLEAN`"
    }
    {
      name: "response_url"
      req: false
      short: "S3 url for downloading the response data."
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "start_date"
      req: true
      short: "The start of the interval time range represented as an ISO-8601 complete date."
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Status of the query."
      type: "`$STRING`"
    }
    {
      name: "status_url"
      req: false
      short: "More information about the subscription's status."
      type: "`$STRING`"
    }
    {
      name: "unique"
      req: false
      short: "Whether or not to return unique values."
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "analytics"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "app_id"
                orig: "app_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "csv"
                kind: "query"
                name: "format"
                orig: "format"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "POST /analytics"
            json: "{\"operationId\":\"exportCohortAnalytics\",\"parameters\":[{\"description\":\"app_id | Unique identifier for Branch app of requested data. Either appId or organization_id is required.\",\"in\":\"query\",\"name\":\"app_id\",\"required\":\"true\",\"schema\":{\"type\":\"string\"}},{\"description\":\"The maximum number of results to return.\",\"explode\":\"true\",\"in\":\"query\",\"name\":\"limit\",\"required\":\"false\",\"schema\":{\"format\":\"int32\",\"maximum\":\"50000\",\"minimum\":\"1\",\"type\":\"integer\"},\"style\":\"form\"},{\"description\":\"Format of returned data. json or csv\",\"explode\":\"true\",\"in\":\"query\",\"name\":\"format\",\"required\":\"false\",\"schema\":{\"default\":\"csv\",\"enum\":[\"csv\",\"json\"],\"type\":\"string\"},\"style\":\"form\"}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Cohort Request Body\",\"properties\":{\"cumulative\":{\"default\":\"false\",\"description\":\"If true, sum across bands so that a given band value is the sum of all preceding values plus the band value.\",\"type\":\"boolean\"},\"data_source\":{\"default\":\"install_cohort\",\"description\":\"A string value representing the cohort type\",\"enum\":[\"install_cohort\",\"reengagement_cohort\"],\"example\":\"install_cohort\",\"type\":\"string\"},\"dimensions\":{\"default\":[\"install_activity_touch_data_tilde_campaign\"],\"description\":\"An array representing dimension(s) to group by. Limit is 11. See [Dimensions](https://help.branch.io/developers-hub/docs/cohort-exports#section-dimensions) for complete list.\\n\",\"example\":[\"install_activity_touch_data_tilde_campaign\"],\"items\":{\"enum\":[\"install_activity_attributed\",\"install_activity_event_name\",\"install_activity_touch_type\",\"install_activity_touch_data_tilde_campaign_id\",\"install_activity_touch_data_tilde_campaign\",\"install_activity_touch_data_tilde_channel\",\"install_activity_touch_data_tilde_feature\",\"install_activity_touch_data_tilde_stage\",\"install_activity_touch_data_tilde_tags\",\"install_activity_touch_data_tilde_advertising_partner_name\",\"install_activity_touch_data_dollar_3p\",\"install_activity_touch_data_tilde_secondary_publisher\",\"install_activity_touch_data_tilde_creative_name\",\"install_activity_touch_data_tilde_ad_id\",\"install_activity_touch_data_tilde_ad_set_id\",\"install_activity_touch_data_tilde_ad_set_name\",\"install_activity_touch_data_tilde_ad_name\",\"install_activity_touch_data_tilde_keyword\",\"install_activity_touch_data_tilde_journey_name\",\"install_activity_touch_data_tilde_view_name\",\"install_activity_touch_data_plus_referring_domain\",\"install_activity_touch_data_plus_via_features\",\"install_activity_touch_data_plus_web_format\",\"install_activity_data_os\",\"install_activity_data_environment\",\"install_activity_data_platform\",\"install_activity_data_country_code\",\"install_activity_data_has_app\",\"install_activity_data_has_clicked_email\",\"install_activity_data_has_clicked_ad\",\"install_activity_timezone_adjusted_day\",\"install_activity_touch_data_tilde_placement\",\"install_activity_data_device_type\",\"install_activity_touch_data_tilde_sub_site_name\",\"install_activity_data_brand\",\"install_activity_data_geo_country_en\",\"install_activity_data_model\",\"install_activity_data_geo_region_en\",\"install_activity_touch_data_tilde_customer_secondary_publisher\",\"install_activity_touch_data_tilde_customer_placement\",\"install_activity_touch_data_tilde_customer_sub_site_name\",\"install_activity_touch_data_tilde_customer_campaign\",\"install_activity_touch_data_tilde_customer_ad_set_name\",\"install_activity_touch_data_tilde_customer_ad_name\",\"install_activity_touch_data_tilde_customer_keyword\",\"install_activity_touch_data_tilde_agency_id\",\"install_activity_touch_data_tilde_agency\",\"customer_event_alias\",\"reengagement_activity_attributed\",\"reengagement_activity_event_name\",\"reengagement_activity_touch_type\",\